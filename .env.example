# LifeDex environment — ALL optional for local mock mode.
# Copy to .env and fill in only what you need. With AI_PROVIDER=mock and
# MAPS_PROVIDER=mock the app runs fully offline with NO API keys.

# Supabase (leave blank to run without a backend in mock mode)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Provider selection: "mock" (default, no keys) or a real provider id.
#   AI_PROVIDER=google       + GOOGLE_CLOUD_VISION_KEY  → generic labels (Bird/Flower)
#   AI_PROVIDER=inaturalist  + INATURALIST_API_TOKEN    → species-accurate IDs (best)
AI_PROVIDER=mock
MAPS_PROVIDER=mock

# Native Google Maps (Android) — only needed for a real zoomable map (Phase 3,
# requires a development/production build; not used in Expo Go / mock map).
# Get one at console.cloud.google.com → enable "Maps SDK for Android" → API key.
GOOGLE_MAPS_API_KEY=

# --- Google Cloud Vision (AI_PROVIDER=google) ---
GOOGLE_CLOUD_VISION_KEY=

# Optional: server-side Vision proxy (Supabase Edge Function). When set, the app
# calls this instead of Google directly, so the key stays off-device (preferred
# for release). Then GOOGLE_CLOUD_VISION_KEY can be removed from the client.
VISION_PROXY_URL=

# --- iNaturalist + PlantNet (AI_PROVIDER=inaturalist) — species-accurate ---
# iNaturalist Computer Vision covers fauna + fungi. Token from
# https://www.inaturalist.org/users/api_token (Bearer). Required for this provider.
INATURALIST_API_TOKEN=
# Optional off-device proxy for the iNat call (keeps the token out of the bundle).
INAT_PROXY_URL=
# PlantNet refines flora IDs. Key from https://my.plantnet.org/ . Optional — if
# unset, iNaturalist still handles plants (just less precisely).
PLANTNET_API_KEY=
# Optional off-device proxy for the PlantNet call.
PLANTNET_PROXY_URL=
# Moderation note: iNat/PlantNet don't moderate. If GOOGLE_CLOUD_VISION_KEY (or
# VISION_PROXY_URL) is also set, moderation reuses Google SafeSearch; else mock.
